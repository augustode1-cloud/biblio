<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="presentacion.NuevoPrestamoFormulario"
      spacing="10" alignment="CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Nuevo Prestamo"/>

    <Label text="Socio"/>
    <ComboBox fx:id="socioCombo"/>

    <Label text="Empleado"/>
    <ComboBox fx:id="empleadoCombo"/>

    <Label text="Libro"/>
    <ComboBox fx:id="libroCombo"/>

    <Label text="Copia"/>
    <ComboBox fx:id="copiaCombo"/>

    <Label text="Fecha Prestamo"/>
    <DatePicker fx:id="fechaPrestamoPicker"/>

    <Label text="Fecha Devolucion Prevista"/>
    <DatePicker fx:id="fechaDevolucionPicker"/>

    <Button text="Aceptar" onAction="#onAceptar"/>
    <Button text="Cancelar" onAction="#onCancelar"/>
</VBox>
