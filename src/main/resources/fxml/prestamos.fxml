<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="presentacion.PrestamoFormulario"
      spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="Prestamos" style="-fx-font-size: 24px;"/>
        <Button text="Libros" onAction="#onIrLibros"/>
        <Button text="Socios" onAction="#onIrSocios"/>
        <Button text="Empleados" onAction="#onIrEmpleados"/>
    </HBox>

    <HBox spacing="8">
        <Label text="ID" prefWidth="50"/>
        <Label text="Socio" prefWidth="140"/>
        <Label text="Empleado" prefWidth="140"/>
        <Label text="Libro" prefWidth="180"/>
        <Label text="Copia" prefWidth="60"/>
        <Label text="F. Prestamo" prefWidth="100"/>
        <Label text="F. Devolucion" prefWidth="100"/>
        <Label text="Estado" prefWidth="80"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="contenedorFilas" spacing="8"/>
        </content>
    </ScrollPane>

    <Button text="+" onAction="#onAgregar"/>
</VBox>
